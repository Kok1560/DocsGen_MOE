@page "/"
@attribute [Authorize]
@inject DocumentService Documents
@inject AuthenticationStateProvider AuthState

<PageTitle>@L["nav.home"]</PageTitle>

<section class="hero">
    <div>
        <h1 class="hero-title">@L.Format("home.hello", username)</h1>
        <p class="hero-sub">@L["home.sub"]</p>
        <a href="templates" class="btn btn-gold mt-3">
            <i class="bi bi-plus-circle-fill" aria-hidden="true"></i> @L["home.create"]
        </a>
    </div>
    <i class="bi bi-mortarboard-fill hero-icon" aria-hidden="true"></i>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-5 col-lg-4">
        <div class="stat-card">
            <span class="action-icon"><i class="bi bi-files" aria-hidden="true"></i></span>
            <div class="stat-body">
                <div class="stat-label">@L["home.count"]</div>
                <div class="stat-value">@count</div>
                <a href="documents" class="small fw-semibold">@L["home.viewdocs"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-7 col-lg-8">
        <a class="action-card" href="templates">
            <span class="action-icon"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span>
            <span class="action-body">
                <span class="action-title">@L["nav.templates"]</span>
                <span class="action-text">@L["home.tpl.text"]</span>
            </span>
            <span class="action-go">@L["home.open"] <i class="bi bi-arrow-right icon-flip" aria-hidden="true"></i></span>
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header card-header-gov"><i class="bi bi-signpost-split-fill" aria-hidden="true"></i> @L["home.steps"]</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="step"><span class="step-no">1</span>
                    <div><div class="step-title">@L["home.s1"]</div><div class="step-text">@L["home.s1.t"]</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="step"><span class="step-no">2</span>
                    <div><div class="step-title">@L["home.s2"]</div><div class="step-text">@L["home.s2.t"]</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="step"><span class="step-no">3</span>
                    <div><div class="step-title">@L["home.s3"]</div><div class="step-text">@L["home.s3.t"]</div></div></div>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private int count;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        username = state.User.Identity?.Name ?? "";
        count = await Documents.CountAsync(state.User.GetUserId());
    }
}
