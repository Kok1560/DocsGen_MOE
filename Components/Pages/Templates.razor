@page "/templates"
@attribute [Authorize]
@inject TemplateService TemplateSvc

<PageTitle>Templates</PageTitle>

<h1 class="h3 mb-3">Templates</h1>

@if (items.Count == 0)
{
    <div class="alert alert-info">
        No templates yet. Copy a <code>.docx</code> file into the <code>Templates</code> folder
        and refresh this page.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var t in items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@t.Name</h5>

                        @if (t.Error is not null)
                        {
                            <p class="text-danger small mb-0">@t.Error</p>
                        }
                        else if (t.Fields.Count == 0)
                        {
                            <p class="text-muted small mb-0">No fields found. Add placeholders like {{Name}} to the document.</p>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">@t.Fields.Count field(s):</p>
                            @foreach (var f in t.Fields)
                            {
                                <span class="badge text-bg-secondary me-1">@f</span>
                            }
                        }
                    </div>
                </div>
            </div>
                @if (t.Error is null)
                {
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a class="btn btn-primary btn-sm"
                           href="@($"editor?template={Uri.EscapeDataString(t.FileName)}")">Use template</a>
                    </div>
                }
        }
    </div>
}

@code {
    private IReadOnlyList<TemplateInfo> items = [];

    protected override void OnInitialized() => items = TemplateSvc.GetAll();
}