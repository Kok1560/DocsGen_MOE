@page "/s/{Token}"
@layout DocGen.Components.Layout.PublicLayout
@attribute [AllowAnonymous]
@inject ShareService Shares

<PageTitle>@(doc?.Name ?? L["shared.title"])</PageTitle>

<HeadContent>
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
</HeadContent>

@if (doc is null)
{
    <div class="alert alert-warning">@L["shared.invalid"]</div>
}
else
{
    <div class="d-flex align-items-center mb-3 gap-2">
        <h1 class="page-title me-auto">@doc.Name</h1>
        <a class="btn btn-primary btn-sm" href="/s/@Token/pdf?download=true">
            <i class="bi bi-download" aria-hidden="true"></i> @L["shared.download"]
        </a>
    </div>

    <iframe src="/s/@Token/pdf" title="@doc.Name" class="pdf-frame"
            style="width:100%; height:85vh; min-height:500px;"></iframe>
}

@code {
    [Parameter] public string Token { get; set; } = "";

    private SharedDocumentInfo? doc;

    protected override async Task OnInitializedAsync() => doc = await Shares.ResolveAsync(Token);
}
