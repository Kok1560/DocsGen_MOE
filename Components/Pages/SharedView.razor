@page "/s/{Token}"
@layout DocGen.Components.Layout.PublicLayout
@attribute [AllowAnonymous]
@inject ShareService Shares

<PageTitle>@(doc?.Name ?? "Shared document")</PageTitle>

<HeadContent>
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
</HeadContent>

@if (doc is null)
{
    <div class="alert alert-warning">
        This link is not valid. It may have expired or been revoked.
    </div>
}
else
{
    <div class="d-flex align-items-center mb-3">
        <h1 class="h4 mb-0 me-auto">@doc.Name</h1>
        <a class="btn btn-primary btn-sm" href="/s/@Token/pdf?download=true">Download PDF</a>
    </div>

    <iframe src="/s/@Token/pdf" title="@doc.Name"
            style="width:100%; height:85vh; min-height:500px; border:1px solid #dee2e6;"></iframe>
}

@code {
    [Parameter] public string Token { get; set; } = "";

    private SharedDocumentInfo? doc;

    protected override async Task OnInitializedAsync() => doc = await Shares.ResolveAsync(Token);
}