@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>@L["register.title"]</PageTitle>

<h1 class="auth-title">@L["register.title"]</h1>
<p class="auth-sub">@L["register.sub"]</p>

<EditForm Model="Input" FormName="register" OnValidSubmit="RegisterAsync" method="post">
    <DataAnnotationsValidator />

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="mb-3">
        <label class="form-label">@L["auth.username"]</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
            <InputText class="form-control" dir="ltr" autocomplete="username" @bind-Value="Input.Username" />
        </div>
        <ValidationMessage For="() => Input.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label">@L["auth.password"]</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
            <InputText type="password" class="form-control" dir="ltr" autocomplete="new-password" @bind-Value="Input.Password" />
        </div>
        <ValidationMessage For="() => Input.Password" />
    </div>

    <div class="mb-4">
        <label class="form-label">@L["auth.confirm"]</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i></span>
            <InputText type="password" class="form-control" dir="ltr" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>

    <button type="submit" class="btn btn-primary w-100 btn-lg">@L["register.btn"]</button>
</EditForm>

<p class="mt-4 mb-0 text-center">@L["register.have"] <a href="login">@L["login.title"]</a></p>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private RegisterModel Input { get; set; } = new();

    private string? error;

    private async Task RegisterAsync()
    {
        var (user, registerError) = await Auth.RegisterAsync(Input.Username, Input.Password);
        if (user is null)
        {
            error = L.Msg(registerError);
            return;
        }

        await HttpContext.SignInUserAsync(user);
        Nav.NavigateTo("/");
    }

    private class RegisterModel
    {
        [LRequired, LStringLength(50, MinimumLength = 3)]
        public string Username { get; set; } = "";

        [LRequired, LStringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";

        [LRequired, LCompare(nameof(Password))]
        public string ConfirmPassword { get; set; } = "";
    }
}
