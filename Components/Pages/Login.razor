@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>@L["login.title"]</PageTitle>

<h1 class="auth-title">@L["login.title"]</h1>
<p class="auth-sub">@L["login.sub"]</p>

<EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post">
    <DataAnnotationsValidator />

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="mb-3">
        <label class="form-label">@L["auth.username"]</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
            <InputText class="form-control" dir="ltr" autocomplete="username" @bind-Value="Input.Username" />
        </div>
        <ValidationMessage For="() => Input.Username" />
    </div>

    <div class="mb-4">
        <label class="form-label">@L["auth.password"]</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
            <InputText type="password" class="form-control" dir="ltr" autocomplete="current-password" @bind-Value="Input.Password" />
        </div>
        <ValidationMessage For="() => Input.Password" />
    </div>

    <button type="submit" class="btn btn-primary w-100 btn-lg">@L["login.title"]</button>
</EditForm>

<p class="mt-4 mb-0 text-center">@L["login.noaccount"] <a href="register">@L["login.register"]</a></p>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginModel Input { get; set; } = new();

    private string? error;

    private async Task LoginAsync()
    {
        var user = await Auth.ValidateAsync(Input.Username, Input.Password);
        if (user is null)
        {
            error = L["login.wrong"];
            return;
        }

        await HttpContext.SignInUserAsync(user);
        Nav.NavigateTo("/");
    }

    private class LoginModel
    {
        [LRequired] public string Username { get; set; } = "";
        [LRequired] public string Password { get; set; } = "";
    }
}
