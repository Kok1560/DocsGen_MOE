@page "/documents"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DocumentService Documents
@inject AuthenticationStateProvider AuthState

<PageTitle>@L["nav.documents"]</PageTitle>

<div class="page-head">
    <h1 class="page-title">@L["nav.documents"]</h1>
</div>

<div class="search-box mb-3">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input class="form-control" dir="auto" placeholder="@L["docs.search"]"
           @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />
</div>

@if (loading)
{
    <p class="text-muted">@L["docs.loading"]</p>
}
else if (items.Count == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(search) ? L["docs.empty"] : L["docs.nomatch"])
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-gov align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center">@L["docs.name"]</th>
                        <th class="text-center">@L["docs.template"]</th>
                        <th class="text-center">@L["docs.created"]</th>
                        <th class="text-center">@L["docs.actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in items)
                    {
                        <tr>
                            <td class="text-center fw-semibold">@d.Name</td>
                            <td class="text-center">@d.TemplateName</td>
                            <td class="text-center" dir="ltr">@FormatDate(d.CreatedAt)</td>
                            <td class="text-center">
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <button class="btn @(viewingId == d.Id ? "btn-primary" : "btn-outline-primary") btn-sm"
                                            @onclick="() => ToggleView(d.Id)">
                                        <i class="bi @(viewingId == d.Id ? "bi-x-lg" : "bi-eye")" aria-hidden="true"></i>
                                        @(viewingId == d.Id ? L["docs.close"] : L["docs.view"])
                                    </button>
                                    <a class="btn btn-outline-primary btn-sm" href="/download/@d.Id/docx" download data-enhance-nav="false">
                                        <i class="bi bi-file-earmark-word" aria-hidden="true"></i> Word
                                    </a>
                                    <a class="btn btn-outline-primary btn-sm" href="/download/@d.Id/pdf" download data-enhance-nav="false">
                                        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF
                                    </a>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleShare(d.Id)">
                                        <i class="bi bi-share" aria-hidden="true"></i> @L["docs.share"]
                                    </button>

                                    @if (confirmingId == d.Id)
                                    {
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(d.Id)">@L["docs.confirmdelete"]</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmingId = null">@L["docs.cancel"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmingId = d.Id">
                                            <i class="bi bi-trash" aria-hidden="true"></i> @L["docs.delete"]
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (viewingId == d.Id)
                        {
                            <tr>
                                <td colspan="4" class="share-panel">
                                    <div class="p-2">
                                        <iframe src="/view/@d.Id" title="@d.Name" class="pdf-frame"
                                                style="width:100%; height:75vh; min-height:500px;"></iframe>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (sharingId == d.Id)
                        {
                            <tr>
                                <td colspan="4" class="share-panel">
                                    <div class="p-2">
                                        <h6 class="mb-2">@L.Format("share.title", d.Name)</h6>

                                        @* These run in the browser directly (not through Blazor), so the share window is allowed to open *@
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                                    data-id="@d.Id" data-name="@d.Name"
                                                    onclick="shareDocumentPdf(this, 'any')">
                                                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF
                                            </button>

                                            <button type="button" class="btn btn-success btn-sm"
                                                    data-id="@d.Id" data-name="@d.Name"
                                                    onclick="shareDocumentPdf(this, 'whatsapp')">
                                                <i class="bi bi-whatsapp" aria-hidden="true"></i> @L["share.whatsapp"]
                                            </button>

                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    data-id="@d.Id"
                                                    data-ok="@L["share.copied"]" data-fail="@L["share.copyfail"]"
                                                    onclick="copyDocumentPdf(this)">
                                                <i class="bi bi-clipboard" aria-hidden="true"></i> @L["share.copy"]
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<DocumentSummary> items = [];
    private string? search;
    private bool loading = true;
    private Guid? confirmingId;
    private Guid? viewingId;
    private Guid? sharingId;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        userId = state.User.GetUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await Documents.ListAsync(userId, search);
        loading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await Documents.DeleteAsync(userId, id);
        confirmingId = null;
        if (sharingId == id) sharingId = null;
        if (viewingId == id) viewingId = null;
        await LoadAsync();
    }

    // ---------- View ----------

    private void ToggleView(Guid id)
    {
        if (viewingId == id)
        {
            viewingId = null;
            return;
        }

        sharingId = null;     // only one panel is open at a time
        confirmingId = null;
        viewingId = id;
    }

    // ---------- Share ----------

    private void ToggleShare(Guid id)
    {
        if (sharingId == id)
        {
            sharingId = null;
            return;
        }

        viewingId = null;     // only one panel is open at a time
        confirmingId = null;
        sharingId = id;
    }

    private static string FormatDate(DateTime utc) =>
        utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}