@page "/documents"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DocumentService Documents
@inject ShareService ShareSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>My documents</PageTitle>

<h1 class="h3 mb-3">My documents</h1>

<input class="form-control mb-3" style="max-width: 360px;" placeholder="Search by name..."
       @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />

@if (loading)
{
    <p class="text-muted">Loading...</p>
}
else if (items.Count == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(search)
            ? "You have no documents yet. Open a template and it will be saved here automatically."
            : "No documents match your search.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Name</th><th>Template</th><th>Created</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var d in items)
                {
                    <tr>
                        <td>@d.Name</td>
                        <td>@d.TemplateName</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn @(viewingId == d.Id ? "btn-secondary" : "btn-outline-secondary") btn-sm"
                                    @onclick="() => ToggleView(d.Id)">
                                @(viewingId == d.Id ? "Close" : "View")
                            </button>
                            <a class="btn btn-outline-primary btn-sm" href="/download/@d.Id/docx" download data-enhance-nav="false">Word</a>
                            <a class="btn btn-outline-primary btn-sm" href="/download/@d.Id/pdf" download data-enhance-nav="false">PDF</a>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleShareAsync(d.Id)">Share</button>

                            @if (confirmingId == d.Id)
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(d.Id)">Confirm delete</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmingId = null">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmingId = d.Id">Delete</button>
                            }
                        </td>
                    </tr>

                    @if (viewingId == d.Id)
                    {
                        <tr>
                            <td colspan="4" class="bg-body-tertiary">
                                <div class="p-2">
                                    <iframe src="/view/@d.Id" title="@d.Name"
                                            style="width:100%; height:75vh; min-height:500px; border:1px solid #dee2e6;"></iframe>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (sharingId == d.Id)
                    {
                        <tr>
                            <td colspan="4" class="bg-body-tertiary">
                                <div class="p-2">
                                    <h6 class="mb-1">Share "@d.Name"</h6>
                                    <p class="text-muted small">
                                        Anyone with the link can view this PDF (read only) without logging in.
                                        They cannot see your other documents.
                                    </p>

                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                        <label class="small mb-0">Link expires</label>
                                        <select class="form-select form-select-sm w-auto" @bind="expiryDays">
                                            <option value="1">in 1 day</option>
                                            <option value="7">in 7 days</option>
                                            <option value="30">in 30 days</option>
                                            <option value="0">never</option>
                                        </select>
                                        <button class="btn btn-primary btn-sm" @onclick="CreateShareAsync">Create link</button>
                                    </div>

                                    @if (shareError is not null)
                                    {
                                        <div class="alert alert-danger py-2">@shareError</div>
                                    }

                                    @if (newLink is not null)
                                    {
                                        <div class="alert alert-success py-2">
                                            <div class="small mb-1">
                                                Copy this link now. For security it cannot be shown again
                                                (you can always create a new one).
                                            </div>
                                            <div class="input-group input-group-sm">
                                                <input class="form-control" readonly value="@newLink" />
                                                <button class="btn btn-outline-success" @onclick="CopyLinkAsync">Copy</button>
                                            </div>

                                            <a class="btn btn-success btn-sm mt-2"
                                               href="@WhatsAppUrl(d.Name)" target="_blank" rel="noopener noreferrer">
                                                Send via WhatsApp
                                            </a>

                                            @if (copyMessage is not null)
                                            {
                                                <div class="small mt-1">@copyMessage</div>
                                            }
                                        </div>
                                    }

                                    @if (shares.Count == 0)
                                    {
                                        <p class="text-muted small mb-0">No links yet.</p>
                                    }
                                    else
                                    {
                                        <table class="table table-sm mb-0">
                                            <thead>
                                                <tr><th>Created</th><th>Expires</th><th>Status</th><th></th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in shares)
                                                {
                                                    <tr>
                                                        <td>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                        <td>@(s.ExpiresAt is null ? "never" : s.ExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</td>
                                                        <td>
                                                            <span class="badge @StatusClass(s.Status)">@s.Status</span>
                                                        </td>
                                                        <td class="text-end">
                                                            @if (s.Status == "Active")
                                                            {
                                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeShareAsync(s.Id)">Revoke</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DocumentSummary> items = [];
    private string? search;
    private bool loading = true;
    private Guid? confirmingId;
    private int userId;

    // Viewing state
    private Guid? viewingId;

    // Sharing state
    private Guid? sharingId;
    private List<ShareInfo> shares = [];
    private int expiryDays = 7;
    private string? newLink;
    private string? copyMessage;
    private string? shareError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        userId = state.User.GetUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await Documents.ListAsync(userId, search);
        loading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await Documents.DeleteAsync(userId, id);   // its share links are deleted with it
        confirmingId = null;
        if (sharingId == id) CloseShare();
        if (viewingId == id) viewingId = null;
        await LoadAsync();
    }

    // ---------- View ----------

    private void ToggleView(Guid id)
    {
        if (viewingId == id)
        {
            viewingId = null;
            return;
        }

        CloseShare();         // only one panel is open at a time
        confirmingId = null;
        viewingId = id;
    }

    // ---------- Share ----------

    private async Task ToggleShareAsync(Guid id)
    {
        if (sharingId == id)
        {
            CloseShare();
            return;
        }

        CloseShare();
        viewingId = null;     // only one panel is open at a time
        confirmingId = null;
        sharingId = id;
        shares = await ShareSvc.ListAsync(userId, id);
    }

    private void CloseShare()
    {
        sharingId = null;
        newLink = null;
        copyMessage = null;
        shareError = null;
        shares = [];
    }

    private async Task CreateShareAsync()
    {
        if (sharingId is not { } id) return;
        shareError = null;
        copyMessage = null;

        var token = await ShareSvc.CreateAsync(userId, id, expiryDays);
        if (token is null)
        {
            shareError = "The link could not be created.";
            return;
        }

        newLink = $"{Nav.BaseUri}s/{token}";
        shares = await ShareSvc.ListAsync(userId, id);
    }

    private async Task RevokeShareAsync(Guid shareId)
    {
        if (sharingId is not { } id) return;

        await ShareSvc.RevokeAsync(userId, shareId);
        newLink = null;      // it may have been the link that is on screen
        copyMessage = null;
        shares = await ShareSvc.ListAsync(userId, id);
    }

    private async Task CopyLinkAsync()
    {
        if (newLink is null) return;
        var ok = await JS.InvokeAsync<bool>("copyText", newLink);
        copyMessage = ok ? "Copied." : "Could not copy automatically. Select the link and press Ctrl+C.";
    }

    // Opens WhatsApp (app or WhatsApp Web) with the message ready; the user picks the contact
    private string WhatsAppUrl(string documentName) =>
        "https://wa.me/?text=" + Uri.EscapeDataString($"{documentName}: {newLink}");

    private static string StatusClass(string status) => status switch
    {
        "Active" => "text-bg-success",
        "Expired" => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}