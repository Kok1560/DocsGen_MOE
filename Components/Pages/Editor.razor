@page "/editor"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject TemplateService TemplateSvc
@inject DocxEngine Engine
@inject PdfConverter Pdf
@inject DocumentService Documents
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ILogger<Editor> Logger

<PageTitle>@L["editor.title"]</PageTitle>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
    <a href="templates"><i class="bi bi-arrow-left icon-flip" aria-hidden="true"></i> @L["editor.backfull"]</a>
}
else
{
    <div class="d-flex align-items-center mb-3 flex-wrap gap-2">
        <a href="templates" class="btn btn-outline-primary btn-sm me-2">
            <i class="bi bi-arrow-left icon-flip" aria-hidden="true"></i> @L["editor.back"]
        </a>
        <h1 class="page-title mb-0">@templateName</h1>
    </div>

    <div class="row g-3">

        @* ===== The form ===== *@
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header card-header-gov">
                    <i class="bi bi-ui-checks-grid" aria-hidden="true"></i> @L["editor.data"]
                </div>
                <div class="card-body">

                    @if (fields.Count == 0)
                    {
                        <p class="text-muted">@L["editor.nofields"]</p>
                    }

                    @foreach (var name in fields)
                    {
                        var key = name;   // copy, so each input binds to its own field
                        <div class="mb-3">
                            <label class="form-label">@key</label>
                            <input class="form-control" dir="auto"
                                   @bind="values[key]"
                                   @bind:event="oninput"
                                   @bind:after="() => OnFieldChanged(key)" />

                            @if (duplicateWarning is not null
                                && key.Equals(DocumentService.PersonNameField, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="alert alert-warning py-1 px-2 small mt-1 mb-0">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @duplicateWarning
                                </div>
                            }
                        </div>
                    }

                    <hr />

                    <div class="mb-1">
                        <label class="form-label">@L["editor.docname"]</label>
                        <input class="form-control" dir="auto" @bind="fileName" @bind:after="RenameAsync" />
                    </div>

                    @if (saveError is not null)
                    {
                        <p class="text-danger small mb-3"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> @saveError</p>
                    }
                    else if (lastSaved is not null)
                    {
                        <p class="text-success small mb-3"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L.Format("editor.savedas", lastSaved.Name)</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-3"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> @L["editor.autosave"]</p>
                    }

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="() => DownloadAsync(false)" disabled="@busy">
                            <i class="bi bi-file-earmark-word" aria-hidden="true"></i> @L["editor.word"]
                        </button>
                        <button class="btn btn-outline-primary" @onclick="() => DownloadAsync(true)" disabled="@busy">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @L["editor.pdf"]
                        </button>
                    </div>

                    @if (busy)
                    {
                        <p class="text-muted small mt-3 mb-0">
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> @L["editor.working"]
                        </p>
                    }

                    @if (actionError is not null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">@actionError</div>
                    }

                    @if (message is not null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            @message <a href="documents">@L["editor.open"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ===== The live preview ===== *@
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header card-header-gov d-flex align-items-center">
                    <span class="fw-semibold me-auto"><i class="bi bi-eye-fill" aria-hidden="true"></i> @L["editor.preview"]</span>

                    @if (previewLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-label="@L["editor.updatingaria"]"></span>
                        <span class="small me-3">@L["editor.updating"]</span>
                    }

                    <button class="btn btn-light btn-sm" @onclick="() => QueuePreview(0)">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @L["editor.refresh"]
                    </button>
                </div>

                @if (previewError is not null)
                {
                    <div class="alert alert-danger m-3 mb-0">@previewError</div>
                }

                <iframe @ref="previewFrame" title="@L["editor.previewtitle"]"
                        style="width:100%; height:75vh; min-height:500px; border:0;"></iframe>
            </div>
        </div>
    </div>
}

@code {
    private const int DebounceMs = 600;

    [SupplyParameterFromQuery(Name = "template")]
    public string? Template { get; set; }

    private string? templatePath;
    private string templateName = "";
    private string fileName = "";
    private int userId;
    private List<string> fields = [];
    private Dictionary<string, string> values = new(StringComparer.OrdinalIgnoreCase);

    private string? error;
    private string? actionError;
    private string? message;
    private bool busy;

    // Preview state
    private ElementReference previewFrame;
    private CancellationTokenSource? previewCts;
    private bool previewLoading;
    private string? previewError;

    // Automatic saving: this editor page owns exactly one document
    private record SavedState(string ValuesKey, string Name, byte[] Docx, byte[] Pdf);
    private Guid? documentId;                              // null until the document is created
    private SavedState? lastSaved;                         // what is currently stored for that document
    private readonly List<Guid> savedIds = [];             // excluded from the duplicate-name warning
    private readonly SemaphoreSlim saveLock = new(1, 1);   // one save at a time (preview and buttons can overlap)
    private string? saveError;

    // Duplicate-name warning state
    private CancellationTokenSource? duplicateCts;
    private string? duplicateWarning;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        userId = state.User.GetUserId();

        // Never trust the name from the address bar: GetPath validates it
        templatePath = Template is null ? null : TemplateSvc.GetPath(Template);
        if (templatePath is null)
        {
            error = L["editor.notfound"];
            return;
        }

        try
        {
            templateName = Path.GetFileNameWithoutExtension(templatePath);
            fileName = templateName;
            fields = Engine.DetectFields(templatePath).ToList();
            foreach (var f in fields) values[f] = "";
        }
        catch
        {
            error = L["editor.unreadable"];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || error is not null) return;

        // After a language switch the page reloads: bring back what the person had typed
        await RestoreDraftAsync();

        // First preview as soon as the page is interactive. It also creates the document.
        QueuePreview(0);
    }

    // ---------- Draft kept in the browser tab (survives the page reload of a language switch) ----------

    private record DraftState(Dictionary<string, string> Values, string FileName, Guid? DocumentId);

    private string DraftKey => "docgen.draft:" + Path.GetFileName(templatePath);

    private async Task SaveDraftAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new DraftState(Snapshot(), fileName, documentId));
            await JS.InvokeVoidAsync("draft.save", DraftKey, json);
        }
        catch
        {
            // the draft is only a convenience: never break the page because of it
        }
    }

    /// <summary>Restores the draft only right after a language switch (the switch button sets a short-lived flag).</summary>
    private async Task RestoreDraftAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("draft.loadIfRestoring", DraftKey);
            if (string.IsNullOrEmpty(json)) return;

            var draft = System.Text.Json.JsonSerializer.Deserialize<DraftState>(json);
            if (draft is null) return;

            foreach (var f in fields)
                if (draft.Values.TryGetValue(f, out var v)) values[f] = v;

            if (!string.IsNullOrWhiteSpace(draft.FileName)) fileName = draft.FileName;

            // Keep working on the SAME document instead of creating a new one
            if (draft.DocumentId is { } id)
            {
                documentId = id;
                savedIds.Add(id);   // so it is not reported as a duplicate of itself
            }

            await InvokeAsync(StateHasChanged);
            QueueDuplicateCheck();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not restore the draft");
        }
    }

    private void OnFieldChanged(string fieldName)
    {
        _ = SaveDraftAsync();
        QueuePreview(DebounceMs);

        if (fieldName.Equals(DocumentService.PersonNameField, StringComparison.OrdinalIgnoreCase))
            QueueDuplicateCheck();
    }

    // ---------- Live preview (+ automatic save) ----------

    /// <summary>Cancels any pending preview and schedules a new one after the delay.</summary>
    private void QueuePreview(int delayMs)
    {
        previewCts?.Cancel();   // the old request will notice and stop
        var cts = previewCts = new CancellationTokenSource();
        _ = RunPreviewAsync(delayMs, cts.Token);
    }

    private async Task RunPreviewAsync(int delayMs, CancellationToken ct)
    {
        try
        {
            if (delayMs > 0) await Task.Delay(delayMs, ct);   // the debounce
            await RefreshPreviewAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // a newer edit replaced this request: nothing to do
        }
    }

    private async Task RefreshPreviewAsync(CancellationToken ct)
    {
        previewLoading = true;
        previewError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var snapshot = Snapshot();
            var docx = Engine.Fill(templatePath!, snapshot);
            var pdf = await Pdf.ConvertAsync(docx, ct);

            ct.ThrowIfCancellationRequested();   // a newer edit arrived while converting: drop this result

            using (var stream = new MemoryStream(pdf))
            using (var streamRef = new DotNetStreamReference(stream))
            {
                await JS.InvokeVoidAsync("setPdfPreview", ct, previewFrame, streamRef);
            }

            await AutoSaveAsync(snapshot, docx, pdf);   // the document in My documents follows the preview
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // the browser tab was closed
        }
        catch (PdfConversionException ex)
        {
            previewError = L.Msg(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Preview failed");
            previewError = L["editor.previewfail"];
        }
        finally
        {
            // If this request was cancelled, a newer one is already running and owns the spinner
            if (!ct.IsCancellationRequested)
            {
                previewLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // ---------- Automatic saving ----------

    private async Task AutoSaveAsync(Dictionary<string, string> snapshot, byte[] docx, byte[] pdf)
    {
        try
        {
            await PersistAsync(snapshot, docx, pdf);
            saveError = null;
            await SaveDraftAsync();   // now the document id is known
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Automatic save failed");
            saveError = L["editor.saveerr"];
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Makes My documents match the editor: creates the document the first time,
    /// replaces its content when the values changed, or only renames it when just the name changed.
    /// </summary>
    private async Task PersistAsync(Dictionary<string, string> snapshot, byte[] docx, byte[] pdf)
    {
        await saveLock.WaitAsync();
        try
        {
            var name = FileNames.Sanitize(fileName);
            var valuesKey = ValuesKey(snapshot);

            if (documentId is not null && lastSaved is not null
                && lastSaved.ValuesKey == valuesKey && lastSaved.Name == name)
                return;   // nothing changed

            if (documentId is not null)
            {
                var sameValues = lastSaved is not null && lastSaved.ValuesKey == valuesKey;
                var ok = sameValues
                    ? await Documents.RenameAsync(userId, documentId.Value, name)
                    : await Documents.UpdateContentAsync(userId, documentId.Value, name, docx, pdf, snapshot);

                if (ok)
                {
                    lastSaved = new SavedState(valuesKey, name, docx, pdf);
                    return;
                }

                // The document was deleted in My documents while this page was open: start a new one
                documentId = null;
                lastSaved = null;
            }

            var (id, savedName) = await Documents.CreateAsync(userId, name, templateName, docx, pdf, snapshot);
            documentId = id;
            savedIds.Add(id);

            // Show the numbered name, unless the person has already typed their own meanwhile
            if (FileNames.Sanitize(fileName) == name) fileName = savedName;
            lastSaved = new SavedState(valuesKey, savedName, docx, pdf);
        }
        finally
        {
            saveLock.Release();
        }
    }

    /// <summary>Runs when the document name box is left or Enter is pressed.</summary>
    private async Task RenameAsync()
    {
        _ = SaveDraftAsync();
        if (documentId is null || lastSaved is null) return;   // not created yet: the first save uses this name

        await saveLock.WaitAsync();
        try
        {
            var name = FileNames.Sanitize(fileName);
            if (documentId is null || lastSaved is null || lastSaved.Name == name) return;

            if (await Documents.RenameAsync(userId, documentId.Value, name))
                lastSaved = lastSaved with { Name = name };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rename failed");
            saveError = L["editor.renameerr"];
        }
        finally
        {
            saveLock.Release();
        }
    }

    // ---------- Duplicate-name warning (never blocks anything) ----------

    private void QueueDuplicateCheck()
    {
        duplicateCts?.Cancel();
        var cts = duplicateCts = new CancellationTokenSource();
        _ = RunDuplicateCheckAsync(cts.Token);
    }

    private async Task RunDuplicateCheckAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(500, ct);   // wait until the person stops typing
            await UpdateDuplicateWarningAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // a newer edit replaced this check
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Duplicate-name check failed");   // a failed check must never break the page
        }
    }

    private async Task UpdateDuplicateWarningAsync(CancellationToken ct)
    {
        values.TryGetValue(DocumentService.PersonNameField, out var personName);
        var match = await Documents.FindPersonDuplicateAsync(userId, personName, savedIds);

        if (ct.IsCancellationRequested) return;

        var shownName = personName?.Trim() ?? "";
        duplicateWarning = match is null ? null : match.Count == 1
            ? L.Format("editor.dup1", shownName, FormatDay(match.LatestCreatedAt), match.LatestDocumentName)
            : L.Format("editor.dupn", match.Count, shownName, FormatDay(match.LatestCreatedAt));

        await InvokeAsync(StateHasChanged);
    }

    private static string FormatDay(DateTime utc) =>
        utc.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    // ---------- Downloads ----------

    private Task DownloadAsync(bool asPdf) => RunAsync(async () =>
    {
        var snapshot = Snapshot();

        // Reuse the stored files when the values haven't changed; otherwise generate fresh ones
        if (lastSaved is not null && lastSaved.ValuesKey == ValuesKey(snapshot))
        {
            await PersistAsync(snapshot, lastSaved.Docx, lastSaved.Pdf);   // only renames if the name changed
        }
        else
        {
            var docx = Engine.Fill(templatePath!, snapshot);
            var pdf = await Pdf.ConvertAsync(docx);
            await PersistAsync(snapshot, docx, pdf);
        }

        var saved = lastSaved!;
        await SendToBrowserAsync(asPdf ? saved.Pdf : saved.Docx, saved.Name + (asPdf ? ".pdf" : ".docx"));

        message = L.Format("editor.savedas", saved.Name) + ".";
        await UpdateDuplicateWarningAsync(CancellationToken.None);   // refresh the warning for the new state
    });

    /// <summary>Runs a button action with a busy flag and friendly error handling.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        actionError = null;
        message = null;
        try
        {
            await action();
        }
        catch (PdfConversionException ex)
        {
            actionError = L.Msg(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Document action failed");
            actionError = L["editor.wrong"];
        }
        finally
        {
            busy = false;
        }
    }

    // A copy of the values, so typing during a slow conversion cannot change what is generated
    private Dictionary<string, string> Snapshot() => new(values, StringComparer.OrdinalIgnoreCase);

    // One string that describes "these values", used to see whether anything changed
    private static string ValuesKey(Dictionary<string, string> snapshot) =>
        string.Join("\u0001", snapshot
            .OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase)
            .Select(kv => kv.Key + "\u0002" + kv.Value));

    private async Task SendToBrowserAsync(byte[] bytes, string downloadName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", downloadName, streamRef);
    }

    public void Dispose()
    {
        previewCts?.Cancel();     // page closed: stop pending work
        duplicateCts?.Cancel();
    }
}