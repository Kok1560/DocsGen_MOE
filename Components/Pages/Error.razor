@page "/Error"
@using System.Diagnostics

<PageTitle>@L["error.title"]</PageTitle>

<div class="py-4">
    <h1 class="text-danger">@L["error.title"]</h1>
    <h2 class="h4 text-danger">@L["error.text"]</h2>

    @if (ShowRequestId)
    {
        <p class="mt-3">
            <strong>@L["error.reqid"]:</strong> <code>@RequestId</code>
        </p>
    }

    <a class="btn btn-primary mt-3" href="/">@L["notfound.home"]</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
